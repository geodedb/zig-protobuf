    "primary": "linux/x86_64",
    "smoke_platforms": ["linux/x86_64", "darwin/arm64", "darwin/x86_64"],
    "cpu_pin_linux": "taskset -c 0",
    "cpu_pin_macos": "not available; log warning; raise variance_gate_multiplier to 5.0 for macOS runs"
  },
