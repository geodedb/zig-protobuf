    "ab_meta_file": "ab_run_meta.json",
    "summary_line_prefix": "NATIVE_BENCH",
    "summary_line_format": "NATIVE_BENCH result=<PASS|FAIL|BASELINE> scenarios=<N> regressions=<N> improvements=<N> ref_a=<sha8|none> ref_b=<sha8>"
  },
  "gating": {
    "formula": "delta_pct = (candidate_median - baseline_median) / baseline_median * 100; effective_gate = max(stddev_a * variance_gate_multiplier, fixed_floor_pct * baseline_median / 100); REGRESSION if delta_pct < max_regression_pct AND abs(candidate_median - baseline_median) > effective_gate",
    "variance_gate_multiplier": 3.0,
    "fixed_floor_pct": 3.0,
    "target_gain_pct": 5.0,
    "max_regression_pct": -3.0,
    "first_run_mode": "baseline — gate logic skipped; all scenario medians written as reference numbers; NATIVE_BENCH result=BASELINE"
  },
